      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 4,
        "w": 4,
        "h": 5
      }
    },
    {
      "title": "서버 오류 비율",
      "type": "stat",
      "description": "실제 요청 중 HTTP 5xx. 트래픽이 없으면 미표시.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_count{namespace=~\"$namespace\",pod=~\"$pod\",uri!~\"/actuator.*|/livez|/readyz\",status=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(http_server_requests_seconds_count{namespace=~\"$namespace\",pod=~\"$pod\",uri!~\"/actuator.*|/livez|/readyz\"}[$__rate_interval])))) / (sum(rate(http_server_requests_seconds_count{namespace=~\"$namespace\",pod=~\"$pod\",uri!~\"/actuator.*|/livez|/readyz\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{namespace}} / {{pod}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "수집 대기",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "wideLayout": true
      },
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 4,
        "h": 5
      }
