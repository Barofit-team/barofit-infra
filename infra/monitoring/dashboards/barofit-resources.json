    {
      "title": "메모리 limit 여유 · 최소",
      "type": "stat",
      "description": "모든 컨테이너에 memory limit이 설정된 Pod만 비교합니다. 일부 컨테이너 limit이 없으면 제외합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(((sum by(namespace,pod)(kube_pod_container_resource_limits{namespace=~\"$namespace\",pod=~\"$pod\",resource=\"memory\"}) and on(namespace,pod) (count by(namespace,pod)(kube_pod_container_resource_limits{namespace=~\"$namespace\",pod=~\"$pod\",resource=\"memory\"} > 0) == count by(namespace,pod)(kube_pod_container_info{namespace=~\"$namespace\",pod=~\"$pod\"}))) > 0) - max by(namespace,pod)(pod_memory_working_set_bytes{namespace=~\"$namespace\",pod=~\"$pod\",metrics_path=\"/metrics/resource\"}))",
          "legendFormat": "{{namespace}} / {{pod}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "limit 미설정 / 수집 대기",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "wideLayout": true
