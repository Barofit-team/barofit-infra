# 사용 시 terraform.tfvars로 복사한 뒤 실제 비밀번호를 입력하세요. (terraform.tfvars는 gitignore 대상)
# cp terraform.tfvars.example terraform.tfvars

rds_password = "CHANGE_ME_STRONG_PASSWORD"
# 난수 입력됨 - 필요 시 담당자 문의

# 필요 시 아래 값을 환경에 맞게 조정하세요.
# rds_instance_class             = "db.t4g.micro"
# rds_engine_version             = "16"
# rds_multi_az                   = false
# rds_availability_zone          = "ap-northeast-2a"
# rds_allowed_security_group_ids = ["sg-xxxxxxxxxxxxxxxxx"]

