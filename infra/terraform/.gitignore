# Terraform local working directories
**/.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan
*.tfplan.json

# Terraform variables (may contain secrets)
*.tfvars
*.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform crash logs
crash.log
crash.*.log

# Terraform CLI configuration
.terraformrc
terraform.rc

# Provider lock files are intentionally tracked
!**/.terraform.lock.hcl

# Local Terraform backup files
*.tf.bak
